---
/* Secciones de la home (excepto el hero). Un solo archivo para que el orden se lea de un vistazo. */
import { Image } from 'astro:assets';
import ProjectCover from './ProjectCover.astro';
import GuideForm from './GuideForm.astro';
import portrait from '../assets/jose.webp';
import { site, bookingHref } from '../config';
import { ui, routes } from '../i18n/ui';
import { published, featured, type Lang } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const book = bookingHref(t.cta.subject);
---

<!-- Prueba -->
<section class="proof" aria-labelledby="proof-h">
  <div class="wrap proof-row">
    <h2 id="proof-h">{t.proof.title(published.length)}</h2>
    <ul role="list">
      {published.map((p) => <li><a href={p.url} target="_blank" rel="noopener">{p.name}</a></li>)}
    </ul>
  </div>
</section>

<!-- Lo que construyo -->
<section class="section" aria-labelledby="services-h">
  <div class="wrap split">
    <div class="split-intro">
      <h2 id="services-h" class="h-section">{t.services.title}</h2>
      <p class="lead">{t.services.lead}</p>
      <p class="tools">{t.services.tools}</p>
    </div>
    <ul class="services" role="list">
      {t.services.items.map((s) => (
        <li><h3>{s.t}</h3><p>{s.d}</p></li>
      ))}
    </ul>
  </div>
</section>

<!-- Trabajos -->
<section id="work" class="section paper" aria-labelledby="work-h">
  <div class="wrap">
    <div class="work-head">
      <h2 id="work-h" class="h-section">{t.work.title}</h2>
      <a class="all" href={routes[lang].projects}>{t.work.all(published.length)}</a>
    </div>
    {featured.map((p, i) => (
      <article class:list={['case', { flip: i % 2 === 1 }]} aria-labelledby={`case-${p.slug}`}>
        <div class="case-media"><ProjectCover project={p} lang={lang} /></div>
        <div class="case-text">
          <p class="kicker">{p.category[lang]}</p>
          <h3 id={`case-${p.slug}`}>{p.name}</h3>
          <p class="label">{t.work.problem}</p>
          <p class="body">{p.problem[lang]}</p>
          <p class="label">{t.work.built}</p>
          <p class="body">{p.built[lang]}</p>
          <p class="result"><strong>{t.work.result}:</strong> {p.result?.[lang] ?? t.work.resultTodo}</p>
          {p.finance && <p class="disclaimer">{t.work.finance}</p>}
          <a class="open" href={p.url} target="_blank" rel="noopener">{t.work.open}<span class="sr-only"> {t.work.opensNew}</span></a>
        </div>
      </article>
    ))}
  </div>
</section>

<!-- Cómo trabajo -->
<section id="process" class="section dark" aria-labelledby="process-h">
  <div class="wrap">
    <h2 id="process-h" class="h-section">{t.process.title}</h2>
    <p class="lead">{t.process.lead}</p>
    <ol class="steps" role="list">
      {t.process.steps.map((s, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Precios -->
<section id="pricing" class="section" aria-labelledby="pricing-h">
  <div class="wrap">
    <h2 id="pricing-h" class="h-section">{t.pricing.title}</h2>
    <p class="lead">{t.pricing.lead}</p>
    <div class="plans">
      {t.pricing.plans.map((p) => {
        const hi = 'highlight' in p && p.highlight;
        return (
          <div class:list={['plan', { hi }]}>
            {hi && <p class="badge">{t.pricing.recommended}</p>}
            <h3>{p.t}</h3>
            <p class="plan-d">{p.d}</p>
            <p class="price">{p.p}</p>
            <ul>{p.f.map((f) => <li>{f}</li>)}</ul>
            <a class:list={['btn', hi ? 'btn-ink' : 'btn-ghost']} href={book}>{t.pricing.cta}</a>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- Sobre mí -->
<section id="about" class="section paper" aria-labelledby="about-h">
  <div class="wrap about">
    <Image src={portrait} alt={t.about.alt} width={400} height={400} class="portrait" loading="lazy" />
    <div class="about-text">
      <h2 id="about-h" class="h-section">{t.about.title}</h2>
      <p class="about-p1">{t.about.p1(site.yearsExperience)}</p>
      <p class="about-p2">{t.about.p2}</p>
      <ul class="creds" role="list">{t.about.creds.map((c) => <li>{c}</li>)}</ul>
      <p class="social"><a href={site.linkedin} rel="me">LinkedIn</a><a href={site.github} rel="me">GitHub</a></p>
    </div>
  </div>
</section>

<!-- Guía -->
{site.guideWebhookUrl && (
  <section class="guide" aria-labelledby="guide-h">
    <div class="wrap guide-row">
      <div class="guide-copy">
        <h2 id="guide-h">{t.guide.title}</h2>
        <p>{t.guide.lead}</p>
      </div>
      <GuideForm lang={lang} />
    </div>
  </section>
)}

<!-- CTA final -->
<section id="book" class="section dark final" aria-labelledby="book-h">
  <div class="wrap center">
    <h2 id="book-h">{t.cta.title}</h2>
    <p class="final-lead">{t.cta.lead}</p>
    <a class="btn btn-chalk big" href={book}>{t.cta.button}</a>
    <p class="mail">{t.cta.or} <a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
</section>

<style>
  /* Prueba */
  .proof { border-bottom: 1px solid var(--line); padding-block: 32px; }
  .proof-row { display: flex; flex-wrap: wrap; gap: 12px 40px; align-items: baseline; }
  .proof h2 { font-family: var(--font-body); font-size: 15px; font-weight: 600; color: var(--muted); }
  .proof ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 26px; }
  .proof a { font-family: var(--font-display); font-size: 19px; font-weight: 600; text-decoration: none; }
  .proof a:hover { text-decoration: underline; text-decoration-color: var(--tiza); text-decoration-thickness: 2px; }

  /* Servicios */
  .split { display: flex; flex-wrap: wrap; gap: 48px 96px; }
  .split-intro { flex: 1 1 300px; }
  .tools { margin: 28px 0 0; font-size: 15px; color: var(--muted); max-width: 26em; }
  .services { flex: 2 1 540px; min-width: 0; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); column-gap: 48px; }
  .services li { border-top: 2px solid var(--pano); padding: 22px 0 34px; }
  .services h3 { font-size: 23px; letter-spacing: -0.01em; margin-bottom: 8px; }
  .services p { margin: 0; color: var(--muted); }

  /* Trabajos */
  .work-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 56px; }
  .all { font-weight: 600; }
  .case { display: flex; flex-wrap: wrap; gap: 36px 64px; align-items: center; padding-bottom: 72px; margin-bottom: 72px; border-bottom: 1px solid var(--line); }
  .case:last-of-type { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .case.flip { flex-direction: row-reverse; }
  .case-media { flex: 1 1 500px; min-width: 0; }
  .case-text { flex: 1 1 360px; min-width: 0; }
  .kicker { margin: 0 0 6px; font-size: 15px; color: var(--muted); }
  .case h3 { font-size: 34px; letter-spacing: -0.02em; margin-bottom: 20px; }
  .label { margin: 0 0 4px; font-weight: 600; }
  .body { margin: 0 0 16px; color: var(--muted); }
  .result { margin: 4px 0 16px; padding: 12px 16px; border-left: 3px solid var(--tiza); background: var(--lino); }
  .disclaimer { margin: -6px 0 16px; font-size: 14px; color: var(--muted); }
  .open { font-weight: 600; }

  /* Proceso */
  .steps { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px 48px; }
  .steps li { border-top: 2px dashed var(--tiza); padding-top: 24px; }
  .num { display: block; font-family: var(--font-display); font-size: 56px; font-weight: 600; line-height: 1; color: var(--tiza); margin-bottom: 12px; }
  .steps h3 { font-size: 25px; margin-bottom: 10px; }
  .steps p { margin: 0; color: var(--soft-on-dark); }

  /* Precios */
  .plans { margin-top: 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .plan { position: relative; display: flex; flex-direction: column; background: var(--papel); border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; }
  .plan.hi { border: 2px solid var(--pano); padding: 31px; }
  .badge { position: absolute; top: -14px; left: 31px; margin: 0; background: var(--tiza); font-size: 13px; font-weight: 600; padding: 4px 12px; border-radius: 999px; }
  .plan h3 { font-size: 24px; margin-bottom: 4px; }
  .plan-d { margin: 0 0 24px; color: var(--muted); font-size: 15px; }
  .price { margin: 0 0 24px; font-family: var(--font-display); font-size: 44px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  .plan ul { margin: 0 0 32px; padding-left: 20px; color: var(--ink-2); flex: 1; }
  .plan li + li { margin-top: 4px; }

  /* Sobre mí */
  .about { display: flex; flex-wrap: wrap; gap: 48px 80px; align-items: center; }
  .portrait { flex: 0 1 400px; width: 100%; max-width: 400px; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); }
  .about-text { flex: 1 1 420px; min-width: 0; }
  .about-text h2 { margin-bottom: 20px; }
  .about-p1 { margin: 0 0 16px; font-size: 19px; color: var(--ink-2); max-width: 32em; }
  .about-p2 { margin: 0 0 28px; color: var(--muted); max-width: 32em; }
  .creds { list-style: none; margin: 0 0 28px; padding: 0; display: grid; gap: 10px; }
  .creds li { padding-left: 20px; border-left: 3px solid var(--tiza); }
  .social { display: flex; gap: 24px; font-weight: 600; margin: 0; }

  /* Guía */
  .guide { border-top: 1px solid var(--line); padding-block: 72px; }
  .guide-row { display: flex; flex-wrap: wrap; gap: 24px 64px; align-items: center; justify-content: space-between; }
  .guide-copy { flex: 1 1 400px; }
  .guide h2 { font-size: 28px; letter-spacing: -0.02em; margin-bottom: 6px; }
  .guide-copy p { margin: 0; color: var(--muted); }

  /* CTA final */
  .final { padding-block: clamp(88px, 12vw, 128px); }
  .center { text-align: center; max-width: 900px; }
  .final h2 { font-size: clamp(34px, 4.4vw, 60px); line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 20px; }
  .final-lead { margin: 0 auto 36px; font-size: 19px; color: var(--soft-on-dark); max-width: 32em; }
  .big { min-height: 56px; padding: 0 32px; font-size: 18px; }
  .mail { margin: 20px 0 0; font-size: 15px; color: var(--muted-on-dark); }

  @media (max-width: 700px) {
    .case.flip { flex-direction: row; }
    .case { padding-bottom: 56px; margin-bottom: 56px; }
    .case h3 { font-size: 28px; }
  }
</style>
